pragma ComponentBehavior: Bound
import QtQuick
import QtQuick.Controls
import QtQuick.Dialogs
import QtQuick.Layouts
import Tibia 1.0
import "../style"
import "../themes/fluent/Colors.js" as Colors

DmeDialog {
    id: dialog
    title: "BlackTek zones"
    width: 820
    height: 790
    modal: false
    dim: false
    required property var reader
    required property var mapView
    property string selectedFile: ""
    property string selectedZone: ""
    property bool zoneNameAutoGenerated: true
    property string suggestedName: ""
    property string status: ""
    property var newFlags: []
    readonly property var creationTypes: [
        {label: "World zone", value: "world", description: "Applies rules such as protection and PvP to an area."},
        {label: "Monster spawn", value: "monster", description: "Defines an area for monsters. Add them afterward with the monster placer."},
        {label: "NPC spawn", value: "npc", description: "Defines an area for NPCs. Add them afterward with the NPC placer."},
        {label: "Boss encounter", value: "boss", description: "Defines a boss encounter. Place the boss first, then place any minions inside the zone."},
        {label: "Item zone (reserved)", value: "item", description: "Creates a recognized item zone entry, but the current BlackTek server does not execute item spawning from it."}
    ]
    readonly property var worldFlagChoices: [
        {label: "Protection", key: "protection", description: "Blocks player combat in this area."},
        {label: "No PvP", key: "nopvp", description: "Disables player-versus-player combat."},
        {label: "PvP", key: "pvp", description: "Enables player combat in this area."},
        {label: "No logout", key: "nologout", description: "Prevents logging out in this area."},
        {label: "No experience", key: "no_experience", description: "Prevents experience gain here."},
        {label: "No trading", key: "no_trading", description: "Blocks player trading here."},
        {label: "No transactions", key: "no_transaction", description: "Blocks transactional actions here."},
        {label: "No party", key: "no_party", description: "Disables party actions in this area."},
        {label: "No item drop", key: "no_drop", description: "Prevents item drops here."},
        {label: "No death", key: "no_death", description: "Applies the server's no-death rule here."},
        {label: "No death penalty", key: "no_death_penalty", description: "Removes the death penalty here."},
        {label: "No equipment loss", key: "no_equipment_loss", description: "Prevents equipment loss on death here."},
        {label: "No summons", key: "no_summons", description: "Prevents summoning creatures here."},
        {label: "Ghost", key: "ghost", description: "Marks this as a ghost zone for server rules."},
        {label: "No pathfinding", key: "no_pathfinding", description: "Disables monster pathfinding here."},
        {label: "No walking", key: "no_walk", description: "Prevents walking into this area."},
        {label: "No monsters", key: "no_monsters", description: "Prevents monster spawns in this area."},
        {label: "No NPCs", key: "no_npcs", description: "Prevents NPC spawns in this area."}
    ]
    readonly property var creationType: creationTypes[zoneType.currentIndex] || creationTypes[0]
    readonly property bool isCreatureZone: ["monster", "npc", "boss"].includes(creationType.value)
    readonly property bool hasDraft: selectedFile.length > 0 && source.text !== sourceBaseline
    readonly property bool canDefineZone: !hasDraft && newZoneName.text.trim().length > 0
        && reader.blackTekZoneFolder.length > 0
    readonly property int selectedTileCount: mapView ? mapView.selectionCount : 0
    readonly property string policyDescription: spawnPolicy.currentText === "relative"
        ? "Creatures spawn relative to the player. The distance from the zone origin to the clicked tile sets the offset."
        : spawnPolicy.currentText === "staged"
        ? "New monsters start in wave 1. Change their wave numbers in Browse & edit after placement."
        : spawnPolicy.currentText === "triggered"
        ? "Creatures activate when the selected event occurs."
        : "Creatures spawn on the tiles where you place them."
    readonly property string triggerDescription: spawnTrigger.currentText === "Enter"
        ? "Activates when a player enters the zone."
        : spawnTrigger.currentText === "Leave"
        ? "Activates when a player leaves the zone."
        : spawnTrigger.currentText === "Death"
        ? "Activates after the selected creature dies."
        : spawnTrigger.currentText === "Despawn"
        ? "Activates when a creature despawns."
        : spawnTrigger.currentText === "Login"
        ? "Activates when a character logs in."
        : spawnTrigger.currentText === "Logout"
        ? "Activates when a character logs out."
        : spawnTrigger.currentText === "Use"
        ? "Activates when a player uses an object."
        : spawnTrigger.currentText === "Speak"
        ? "Activates when a creature speaks."
        : spawnTrigger.currentText === "Attack"
        ? "Activates when a creature attacks."
        : spawnTrigger.currentText === "Defend"
        ? "Activates when a creature is attacked."
        : "Activates when the selected " + spawnTrigger.currentText + " server event occurs."
    readonly property string flagsDescription: {
        const selected = worldFlagChoices.filter(flag => newFlags.includes(flag.key))
        return selected.length ? "Selected: " + selected.map(flag => flag.label).join(", ")
            : "Choose rules for this zone. Hover a rule for its description."
    }
    readonly property var selectedEntry: reader.blackTekZoneEntries.find(entry =>
        entry.name === selectedZone && entry.sourceFile === selectedFile) || null

    function typeLabel(type) {
        return (creationTypes.find(entry => entry.value === type) || creationTypes[0]).label
    }

    function suggestedZoneName(type) {
        const prefixes = {
            world: "World Zone",
            monster: "Monster Spawn",
            npc: "NPC Spawn",
            boss: "Boss Zone",
            item: "Item Zone"
        }
        const prefix = prefixes[type] || "Zone"
        const prefixLower = prefix.toLowerCase() + " "
        let largest = 0
        const names = reader.blackTekZoneEntries.map(entry => entry.name.toLowerCase())
        for (const entry of reader.blackTekZoneEntries) {
            const name = entry.name.trim().toLowerCase()
            if (!name.startsWith(prefixLower)) continue
            const suffix = name.substring(prefixLower.length)
            if (/^\d+$/.test(suffix)) largest = Math.max(largest, Number(suffix))
        }
        let candidate = ""
        do {
            candidate = prefix + " " + (++largest)
        } while (names.includes(candidate.toLowerCase()))
        return candidate
    }

    function refreshSuggestedZoneName() {
        suggestedName = suggestedZoneName(creationType.value)
        zoneNameAutoGenerated = true
        newZoneName.text = suggestedName
    }

    function newZoneOptions() {
        return {
            name: newZoneName.text.trim(),
            type: creationType.value,
            policy: isCreatureZone ? spawnPolicy.currentText : "",
            trigger: isCreatureZone && spawnPolicy.currentText === "triggered" ? spawnTrigger.currentText : "",
            flags: newFlags
        }
    }

    function startPaintingNewZone() {
        const options = newZoneOptions()
        if (mapView.blackTekZonePaintActive) mapView.stopBlackTekZonePainting()
        if (!mapView.startBlackTekZoneTypePainting(options)) {
            status = "Could not start the zone painter. Check the linked zones folder and zone name."
            return
        }
        dialog.close()
    }

    function startWorldPresetPainting(preset) {
        const flagByPreset = {PZ: "protection", NP: "nopvp", NL: "nologout", PvP: "pvp"}
        const flag = flagByPreset[preset]
        if (!flag) return false
        if (mapView.blackTekZonePaintActive) mapView.stopBlackTekZonePainting()
        const options = {
            name: suggestedZoneName("world"),
            type: "world",
            flags: [flag],
            preset: preset
        }
        if (!mapView.startBlackTekZoneTypePainting(options)) return false
        status = "Painting a new " + flag + " world zone. The first stroke creates it; later strokes add tiles."
        if (dialog.visible) dialog.close()
        return true
    }

    function selectZone(entry) {
        if (hasDraft && (entry.sourceFile !== selectedFile || entry.name !== selectedZone)) {
            status = "Apply or discard the current draft before loading another zone."
            return
        }
        if (!hasDraft) openSource(entry.sourceFile)
        selectedZone = entry.name
        revealZone(entry.sourceFile, entry.name)
        status = ""
    }

    function commitSource(text, successMessage) {
        if (reader.blackTekZoneFileText(selectedFile) !== sourceBaseline) {
            status = "This file changed in the document. Reload the zone before editing."
            return false
        }
        const error = reader.editBlackTekZoneFile(selectedFile, text)
        if (!error) openSource(selectedFile)
        status = error || (successMessage + " Save the map to write the change to disk.")
        return !error
    }

    function changeSelectedZoneType() {
        const type = editZoneType.currentValue
        const updated = reader.changeBlackTekZoneType(source.text, selectedZone, type)
        if (!updated) {
            status = "Could not change this zone type. Reload the zone and try again."
            return
        }
        const message = type === "world"
            ? "Changed to a world zone. Previous spawn entries were removed."
            : type === "item"
            ? "Changed to an item zone. This server does not execute item spawns."
            : "Changed to " + type + ". Add its first spawn entry below."
        if (commitSource(updated, message))
            editZoneType.currentIndex = dialog.creationTypes.findIndex(entry => entry.value === type)
    }

    function toggleSelectedZoneFlag(flag, checked) {
        if (!selectedZone || hasDraft) return
        const current = (zoneGeometry.flags || []).slice()
        const opposite = flag === "pvp" ? "nopvp" : flag === "nopvp" ? "pvp" : ""
        let flags = current.filter(value => value !== flag && (!checked || value !== opposite))
        if (checked) flags.push(flag)
        const updated = reader.replaceBlackTekZoneField(
            source.text, selectedZone, "flags", JSON.stringify(flags), false)
        if (!updated) {
            status = "Could not update this zone's world rules."
            return
        }
        commitSource(updated, "World rules updated.")
    }

    function beginPaintingSelectedZone() {
        if (!selectedZone || !selectedFile || hasDraft) return
        if (mapView.blackTekZonePaintActive) mapView.stopBlackTekZonePainting()
        if (!mapView.startBlackTekZonePainting(selectedFile, selectedZone)) {
            status = "Could not start painting this zone."
            return
        }
        revealZone(selectedFile, selectedZone)
        status = "Painting " + selectedZone + ". Drag to add tiles. Hold Ctrl to erase explicit tiles. Click Finish or press Escape to leave the editor."
        dialog.close()
    }

    function createZone() {
        const result = mapView.createBlackTekZoneFromSelection(newZoneOptions())
        if (result.error) {
            status = result.error
            return
        }
        openSource(result.sourceFile)
        selectedZone = result.name
        filter.text = ""
        typeFilter.currentIndex = 0
        refreshSuggestedZoneName()
        tabs.currentIndex = 1
        revealZone(result.sourceFile, result.name)
        status = "Created " + result.name + ". Save the map to write it to disk."
    }
    property string sourceBaseline: ""
    property string sourceFolder: ""
    property int zoneRevision: 0
    readonly property var zoneGeometry: {
        const revision = zoneRevision
        return selectedZone && selectedFile
            ? reader.blackTekZoneGeometry(selectedFile, selectedZone) : ({})
    }
    readonly property var spawnGroups: {
        switch (zoneGeometry.type) {
        case "monster": return [{label: "Monsters", value: "monsters"}]
        case "npc": return [{label: "NPCs", value: "npcs"}]
        case "boss": return [{label: "Boss master", value: "master"}, {label: "Boss minions", value: "minions"}]
        default: return []
        }
    }
    readonly property var groupEntries: (zoneGeometry.creatures || []).filter(
        entry => entry.category === spawnGroup.currentValue)
    readonly property var selectedSpawn: groupEntries[spawnEntry.currentIndex] || null
    function spawnFieldPath(entry, fieldName) {
        return entry.category === "master" ? "master." + fieldName
            : entry.category + "." + entry.index + "." + fieldName
    }
    function locateFolder() { picker.open() }
    function openForCreation() {
        dialog.open()
        tabs.currentIndex = 0
        newZoneName.forceActiveFocus()
    }
    function openForSpawnCreation(filterType) {
        openForCreation()
        zoneType.currentIndex = creationTypes.findIndex(entry =>
            entry.value === (filterType === "npc" ? "npc" : "monster"))
        spawnPolicy.currentIndex = 0
        refreshSuggestedZoneName()
    }
    function openForZoneAt(x, y, floor) {
        const entry = reader.blackTekZoneAt(x, y, floor)
        if (!entry.name) return false
        dialog.open()
        openSource(entry.sourceFile)
        selectedZone = entry.name
        filter.text = ""
        typeFilter.currentIndex = 0
        tabs.currentIndex = 1
        revealZone(entry.sourceFile, entry.name)
        status = "Selected " + entry.name + "."
        return true
    }
    function mapPosition() {
        return mapView.hoverX < 0 || mapView.hoverY < 0 ? ""
            : mapView.hoverX + ":" + mapView.hoverY + ":" + mapView.floor
    }
    function fieldChoices(key) {
        switch (key) {
        case "spawn_type": return ["monster", "npc", "boss", "item"]
        case "policy": return ["fixed", "relative", "staged", "triggered"]
        case "trigger": return ["Spawn", "Enter", "Leave", "Death", "Despawn", "Login", "Logout",
                "Use", "Remove", "Transform", "Speak", "Look", "Summon", "Equip", "DeEquip",
                "Attack", "Defend", "Idle", "GainSkull", "LoseSkull", "Kill", "EnterBattle", "LeaveBattle"]
        case "minion_behavior": return ["despawn_on_master_death", "finish_life_only", "independent_respawn"]
        case "flags": return ["protection", "nopvp", "pvp", "nologout", "no_experience",
                "no_trading", "no_transaction", "no_party", "no_drop", "no_death",
                "no_death_penalty", "no_equipment_loss", "no_summons", "ghost",
                "no_pathfinding", "no_walk", "no_monsters", "no_npcs"]
        case "weekdays": return ["monday", "tuesday", "wednesday", "thursday", "friday", "saturday", "sunday"]
        case "passive": case "forced": case "rebootable": case "resumable": case "degradable": case "timed":
            return ["true", "false"]
        default: return []
        }
    }
    signal revealZone(string path, string name)
    onReaderChanged: if (dialog.visible) dialog.close()
    function openSource(path) {
        selectedFile = path
        sourceFolder = reader.blackTekZoneFolder
        sourceBaseline = reader.blackTekZoneFileText(path)
        source.text = sourceBaseline
    }
    Connections {
        target: dialog.reader
        function onBlackTekZonesChanged() {
            ++dialog.zoneRevision
            if (!dialog.selectedFile) return
            if (dialog.sourceFolder !== dialog.reader.blackTekZoneFolder) {
                dialog.selectedFile = ""
                dialog.selectedZone = ""
                source.text = ""
                dialog.status = "The zone folder changed. Select a zone to continue editing."
                return
            }
            if (source.text === dialog.sourceBaseline) dialog.openSource(dialog.selectedFile)
        }
    }
    function spawnOffset() {
        const zone = zoneGeometry
        if (zone.playerRelative) return relativeOffset.text.trim()
        const position = mapPosition()
        if (!position || zone.originX === undefined) return ""
        const offset = position.split(":").map(Number)
        offset[0] -= zone.originX
        offset[1] -= zone.originY
        offset[2] -= zone.originZ
        return offset.some(value => value < 0) ? "" : offset.join(":")
    }
    onAboutToShow: {
        selectedFile = ""
        selectedZone = ""
        source.text = ""
        status = ""
        newFlags = []
        tabs.currentIndex = 0
        refreshSuggestedZoneName()
    }

    FolderDialog {
        id: picker
        title: "Locate BlackTek zones folder"
        onAccepted: {
            if (!dialog.reader.linkBlackTekZones(Backend.fileTools.toLocalFile(picker.selectedFolder))) {
                dialog.status = "Cannot link this folder. Save pending changes before switching folders."
                return
            }
            dialog.selectedFile = ""
            source.text = ""
        }
    }

    ColumnLayout {
        anchors.fill: parent
        RowLayout {
            Layout.fillWidth: true
            Label {
                Layout.fillWidth: true
                elide: Text.ElideMiddle
                text: dialog.reader.blackTekZoneFolder
            }
            DmeButton { text: "Locate zones folder…"; onClicked: picker.open() }
        }
        Label {
            Layout.fillWidth: true
            wrapMode: Text.Wrap
            text: dialog.status
            visible: text.length > 0
        }
        ScrollView {
            Layout.fillWidth: true
            Layout.preferredHeight: Math.min(96, diagnostics.implicitHeight)
            visible: diagnostics.text.length > 0
            TextArea {
                id: diagnostics
                readOnly: true
                textFormat: TextEdit.PlainText
                wrapMode: TextEdit.Wrap
                text: dialog.reader.blackTekZoneErrors.join("\n")
            }
        }
        TabBar {
            id: tabs
            Layout.fillWidth: true
            TabButton { text: "New zone" }
            TabButton { text: "Browse & edit" }
        }
        StackLayout {
            Layout.fillWidth: true
            Layout.fillHeight: true
            currentIndex: tabs.currentIndex

            ScrollView {
                id: creationScroll
                Layout.fillWidth: true
                Layout.fillHeight: true
                contentWidth: availableWidth
                ColumnLayout {
                    width: creationScroll.availableWidth
                    spacing: 8
                    Rectangle {
                        Layout.fillWidth: true
                        radius: 5
                        color: Colors.c("surface")
                        border.color: Colors.c("border")
                        implicitHeight: selectionInfo.implicitHeight + 16
                        ColumnLayout {
                            id: selectionInfo
                            anchors.fill: parent
                            anchors.margins: 8
                            spacing: 2
                            Label {
                                Layout.fillWidth: true
                                font.bold: true
                                text: dialog.selectedTileCount > 0
                                    ? dialog.selectedTileCount + (dialog.selectedTileCount === 1 ? " selected tile" : " selected tiles")
                                    : "No tiles selected"
                            }
                            Label {
                                Layout.fillWidth: true
                                wrapMode: Text.WordWrap
                                color: Colors.c("accent")
                                text: "Paint the zone on the map, or select tiles with Shift-drag or the lasso first."
                            }
                        }
                    }
                    GridLayout {
                        Layout.fillWidth: true
                        columns: 2
                        columnSpacing: 10
                        rowSpacing: 6
                        Label { text: "Name" }
                        DmeTextField {
                            id: newZoneName
                            Layout.fillWidth: true
                            placeholderText: "Zone name"
                            onTextChanged: dialog.zoneNameAutoGenerated = text === dialog.suggestedName
                        }
                        Label { text: "Zone type" }
                        ComboBox {
                            id: zoneType
                            Layout.fillWidth: true
                            model: dialog.creationTypes
                            textRole: "label"
                            onActivated: {
                                spawnPolicy.currentIndex = 0
                                if (dialog.zoneNameAutoGenerated) dialog.refreshSuggestedZoneName()
                            }
                        }
                    }
                    Rectangle {
                        Layout.fillWidth: true
                        radius: 5
                        color: Colors.c("surface")
                        border.color: Colors.c("accent")
                        implicitHeight: typeHelp.implicitHeight + 14
                        ColumnLayout {
                            id: typeHelp
                            anchors.fill: parent
                            anchors.margins: 7
                            spacing: 2
                            Label {
                                Layout.fillWidth: true
                                text: dialog.creationType.label
                                color: Colors.c("accent")
                                font.bold: true
                            }
                            Label {
                                Layout.fillWidth: true
                                wrapMode: Text.WordWrap
                                text: dialog.creationType.description
                                color: Colors.c("muted")
                            }
                        }
                    }
                    Label { text: "Spawn behavior"; visible: dialog.isCreatureZone; font.bold: true }
                    GridLayout {
                        Layout.fillWidth: true
                        columns: 2
                        columnSpacing: 10
                        rowSpacing: 6
                        visible: dialog.isCreatureZone
                        Label { text: "Policy" }
                        ComboBox {
                            id: spawnPolicy
                            Layout.fillWidth: true
                            model: dialog.creationType.value === "npc"
                                ? ["fixed", "relative"]
                                : dialog.creationType.value === "boss"
                                    ? ["fixed", "relative", "triggered"] : dialog.fieldChoices("policy")
                        }
                        Label { text: "Trigger"; visible: spawnPolicy.currentText === "triggered" }
                        ComboBox {
                            id: spawnTrigger
                            Layout.fillWidth: true
                            visible: dialog.isCreatureZone && spawnPolicy.currentText === "triggered"
                            model: dialog.fieldChoices("trigger")
                        }
                    }
                    Rectangle {
                        Layout.fillWidth: true
                        visible: dialog.isCreatureZone
                        radius: 5
                        color: Colors.c("surface")
                        border.color: Colors.c("accent")
                        implicitHeight: policyHelpColumn.implicitHeight + 12
                        ColumnLayout {
                            id: policyHelpColumn
                            anchors.fill: parent
                            anchors.margins: 6
                            Label {
                                id: policyHelp
                                Layout.fillWidth: true
                                wrapMode: Text.WordWrap
                                text: dialog.policyDescription
                                color: Colors.c("accent")
                            }
                            Label {
                                Layout.fillWidth: true
                                visible: spawnPolicy.currentText === "triggered"
                                wrapMode: Text.WordWrap
                                text: dialog.triggerDescription
                                color: Colors.c("muted")
                            }
                        }
                    }
                    Rectangle {
                        Layout.fillWidth: true
                        radius: 5
                        color: Colors.c("surface")
                        border.color: Colors.c("border")
                        implicitHeight: flagsColumn.implicitHeight + 12
                        ColumnLayout {
                            id: flagsColumn
                            anchors.fill: parent
                            anchors.margins: 6
                            spacing: 2
                            Label { text: "Zone rules"; font.bold: true }
                            Label {
                                Layout.fillWidth: true
                                wrapMode: Text.WordWrap
                                text: dialog.flagsDescription
                                color: Colors.c("muted")
                            }
                            GridLayout {
                                Layout.fillWidth: true
                                columns: 3
                                columnSpacing: 4
                                rowSpacing: 0
                                Repeater {
                                    model: dialog.worldFlagChoices
                                    CheckBox {
                                        required property var modelData
                                        text: modelData.label
                                        checked: dialog.newFlags.includes(modelData.key)
                                        ToolTip.visible: hovered
                                        ToolTip.text: modelData.description
                                        onToggled: {
                                            const flag = modelData.key
                                            const opposite = flag === "pvp" ? "nopvp" : flag === "nopvp" ? "pvp" : ""
                                            let flags = dialog.newFlags.filter(value => value !== flag
                                                && (!checked || value !== opposite))
                                            if (checked) flags.push(flag)
                                            dialog.newFlags = flags
                                        }
                                    }
                                }
                            }
                        }
                    }
                    Label {
                        Layout.fillWidth: true
                        wrapMode: Text.Wrap
                        visible: dialog.hasDraft
                        text: "Apply or discard your existing edits before creating another zone."
                    }
                    Label {
                        Layout.fillWidth: true
                        visible: dialog.reader.blackTekZoneFolder.length === 0
                        wrapMode: Text.Wrap
                        text: "Save the map or locate its zone folder before creating a zone."
                    }
                    RowLayout {
                        DmeButton {
                            text: "Paint zone"
                            variant: "primary"
                            enabled: dialog.canDefineZone
                            onClicked: dialog.startPaintingNewZone()
                        }
                        DmeButton {
                            text: "Create from selected tiles"
                            enabled: dialog.canDefineZone && dialog.selectedTileCount > 0
                            onClicked: dialog.createZone()
                        }
                    }
                }
            }

            RowLayout {
                spacing: 12
                ColumnLayout {
                    Layout.preferredWidth: 270
                    Layout.fillHeight: true
                    DmeTextField { id: filter; Layout.fillWidth: true; placeholderText: "Search zones" }
                    GridLayout {
                        Layout.fillWidth: true
                        columns: 2
                        Repeater {
                            model: [{label: "All", value: ""}].concat(dialog.creationTypes)
                            Button {
                                required property var modelData
                                required property int index
                                Layout.fillWidth: true
                                text: modelData.label
                                checkable: true
                                checked: typeFilter.currentValue === modelData.value
                                ToolTip.visible: hovered && modelData.value === "item"
                                ToolTip.text: "Reserved: the current server does not execute item spawns."
                                onClicked: typeFilter.currentIndex = index
                            }
                        }
                    }
                    ComboBox {
                        id: typeFilter
                        visible: false
                        model: [{label: "All zone types", value: ""}].concat(dialog.creationTypes)
                        textRole: "label"
                        valueRole: "value"
                    }
                    ListView {
                        id: zoneList
                        Layout.fillWidth: true
                        Layout.fillHeight: true
                        clip: true
                        model: dialog.reader.blackTekZoneEntries.filter(entry =>
                            entry.name.toLowerCase().includes(filter.text.trim().toLowerCase())
                            && (!typeFilter.currentValue || (entry.type || "world") === typeFilter.currentValue))
                        delegate: ItemDelegate {
                            id: zoneRow
                            required property var modelData
                            width: ListView.view.width
                            text: modelData.name
                            highlighted: dialog.selectedZone === modelData.name && dialog.selectedFile === modelData.sourceFile
                            onClicked: dialog.selectZone(modelData)
                            contentItem: ColumnLayout {
                                spacing: 2
                                Label {
                                    Layout.fillWidth: true
                                    text: zoneRow.modelData.name
                                    elide: Text.ElideRight
                                    font.bold: zoneRow.highlighted
                                }
                                Label {
                                    Layout.fillWidth: true
                                    text: dialog.typeLabel(zoneRow.modelData.type) + " ? Floor " + zoneRow.modelData.z
                                    elide: Text.ElideRight
                                    opacity: 0.75
                                }
                            }
                        }
                    }
                    Label {
                        Layout.fillWidth: true
                        visible: zoneList.count === 0
                        text: "No zones match."
                    }
                }
                ScrollView {
                    id: detailScroll
                    Layout.fillWidth: true
                    Layout.fillHeight: true
                    contentWidth: availableWidth
                    ColumnLayout {
                        width: detailScroll.availableWidth
                        CheckBox {
                            id: advanced
                            text: "Advanced settings and source TOML"
                        }
                        Label {
                            Layout.fillWidth: true
                            text: dialog.selectedZone || "Select a zone to edit it."
                            font.bold: true
                            elide: Text.ElideMiddle
                        }
                        Label {
                            visible: dialog.selectedZone.length > 0
                            text: dialog.typeLabel(dialog.zoneGeometry.type)
                        }
                        RowLayout {
                            Layout.fillWidth: true
                            visible: dialog.selectedZone.length > 0 && advanced.checked
                            Label { text: "Change type" }
                            ComboBox {
                                id: editZoneType
                                Layout.fillWidth: true
                                model: dialog.creationTypes
                                textRole: "label"
                                valueRole: "value"
                                currentIndex: Math.max(0, dialog.creationTypes.findIndex(entry =>
                                    entry.value === (dialog.zoneGeometry.type || "world")))
                            }
                            DmeButton {
                                text: "Apply type"
                                enabled: !dialog.hasDraft && editZoneType.currentValue !== (dialog.zoneGeometry.type || "world")
                                onClicked: dialog.changeSelectedZoneType()
                            }
                        }
                        Label {
                            Layout.fillWidth: true
                            visible: dialog.selectedZone.length > 0 && advanced.checked
                            wrapMode: Text.WordWrap
                            color: Colors.c("muted")
                            text: "Changing type resets existing spawn entries; world zones keep their selected map flags."
                        }
                        RowLayout {
                            Layout.fillWidth: true
                            visible: !!dialog.selectedEntry
                            DmeButton {
                                text: "Go to zone"
                                onClicked: {
                                    const entry = dialog.selectedEntry
                                    if (!entry) return
                                    dialog.mapView.centerOnTile(entry.x, entry.y, entry.z)
                                    dialog.revealZone(entry.sourceFile, entry.name)
                                }
                            }
                            DmeButton {
                                text: "Paint zone tiles"
                                visible: (dialog.zoneGeometry.tiles || []).length > 0
                                enabled: !dialog.hasDraft
                                onClicked: dialog.beginPaintingSelectedZone()
                            }
                        }
                        Label {
                            text: "Zone rules"
                            font.bold: true
                            visible: !!dialog.selectedEntry
                        }
                        Flow {
                            Layout.fillWidth: true
                            visible: !!dialog.selectedEntry
                            spacing: 4
                            Repeater {
                                model: dialog.worldFlagChoices
                                CheckBox {
                                    required property var modelData
                                    enabled: !dialog.hasDraft
                                    text: modelData.label
                                    checked: (dialog.zoneGeometry.flags || []).includes(modelData.key)
                                    ToolTip.visible: hovered
                                    ToolTip.text: modelData.description
                                    onToggled: dialog.toggleSelectedZoneFlag(modelData.key, checked)
                                }
                            }
                        }
                        RowLayout {
                            Layout.fillWidth: true
                            visible: dialog.selectedZone.length > 0
                            DmeTextField { id: renameField; Layout.fillWidth: true; placeholderText: "New name for selected zone" }
                            DmeButton {
                                text: "Rename zone"
                                enabled: !dialog.hasDraft && renameField.text.trim().length > 0
                                onClicked: {
                                    const name = renameField.text.trim()
                                    const updated = dialog.reader.changeBlackTekZoneName(source.text, dialog.selectedZone, name)
                                    if (!updated) { dialog.status = "Could not rename the selected zone."; return }
                                    if (dialog.commitSource(updated, "Zone renamed.")) {
                                        dialog.selectedZone = name
                                        renameField.text = ""
                                        dialog.revealZone(dialog.selectedFile, name)
                                    }
                                }
                            }
                            DmeButton {
                                text: "Remove zone"
                                enabled: !dialog.hasDraft
                                onClicked: {
                                    const updated = dialog.reader.changeBlackTekZoneName(source.text, dialog.selectedZone, "")
                                    if (!updated) { dialog.status = "Could not remove the selected zone."; return }
                                    if (dialog.commitSource(updated, "Zone removed.")) {
                                        dialog.selectedZone = ""
                                        dialog.revealZone("", "")
                                    }
                                }
                            }
                        }
                        RowLayout {
                            Layout.fillWidth: true
                            visible: dialog.selectedZone.length > 0 && advanced.checked
                            ComboBox {
                                id: field
                                model: ["range", "positions", "flags", "spawn_type", "policy", "monsters",
                                        "npcs", "master", "minions", "cooldown", "trigger", "minion_behavior",
                                        "weekdays", "passive", "forced", "rebootable", "resumable", "degradable", "timed"]
                            }
                            ComboBox {
                                id: fieldPreset
                                visible: count > 0
                                model: dialog.fieldChoices(field.currentText)
                                onActivated: {
                                    const key = field.currentText
                                    if (key === "flags" || key === "weekdays") {
                                        const updated = dialog.reader.replaceBlackTekZoneField(
                                            source.text, dialog.selectedZone, key, JSON.stringify(currentText), true)
                                        if (!updated) {
                                            dialog.status = "Could not add to the list. Check its TOML value."
                                            return
                                        }
                                        source.text = updated
                                        dialog.status = "List entry added. Review and apply the change."
                                    } else {
                                        fieldValue.text = currentText === "true" || currentText === "false"
                                            ? currentText : JSON.stringify(currentText)
                                    }
                                }
                            }
                            DmeTextField {
                                id: fieldValue
                                Layout.fillWidth: true
                                placeholderText: "New TOML value"
                            }
                            DmeButton {
                                text: "Set field"
                                onClicked: {
                                    const updated = dialog.reader.replaceBlackTekZoneField(
                                        source.text, dialog.selectedZone, field.currentText, fieldValue.text, false)
                                    if (!updated) {
                                        dialog.status = "Could not set that field. Check the source TOML."
                                        return
                                    }
                                    source.text = updated
                                    dialog.status = "Review the value, then apply the change."
                                }
                            }
                        }
                        Label {
                            Layout.fillWidth: true
                            visible: dialog.spawnGroups.length > 0
                            wrapMode: Text.WordWrap
                            text: "To add creatures, choose one in the Creature Palette and click a tile inside this zone."
                        }
                        RowLayout {
                            Layout.fillWidth: true
                            visible: dialog.spawnGroups.length > 0
                            ComboBox {
                                id: spawnGroup
                                textRole: "label"
                                valueRole: "value"
                                model: dialog.spawnGroups
                            }
                            ComboBox {
                                id: spawnEntry
                                Layout.fillWidth: true
                                model: dialog.groupEntries.map(entry => (entry.index + 1) + ". " + (entry.name || "Creature list")
                                    + (entry.hasPosition ? " (" + entry.position.x + ":" + entry.position.y + ":" + entry.position.z + ")" : ""))
                            }
                            DmeTextField {
                                id: relativeOffset
                                visible: !!dialog.zoneGeometry.playerRelative
                                placeholderText: "Player-relative offset"
                            }
                            DmeButton {
                                text: dialog.zoneGeometry.playerRelative ? "Set spawn offset" : "Move spawn to hovered tile"
                                enabled: !!dialog.selectedSpawn && !dialog.hasDraft && !dialog.hasDraft
                                onClicked: {
                                    const offset = dialog.spawnOffset()
                                    if (!offset) {
                                        dialog.status = dialog.zoneGeometry.playerRelative
                                            ? "Enter an offset such as 2:0:0." : "Hover the destination tile at or after the zone origin."
                                        return
                                    }
                                    const path = dialog.spawnFieldPath(dialog.selectedSpawn, "position")
                                    const updated = dialog.reader.replaceBlackTekZoneField(
                                        source.text, dialog.selectedZone, path, JSON.stringify(offset), false)
                                    if (!updated) { dialog.status = "Could not set the position in this spawn entry."; return }
                                    dialog.commitSource(updated, "Spawn position updated.")
                                }
                            }
                        }
                        RowLayout {
                            Layout.fillWidth: true
                            visible: dialog.spawnGroups.length > 0 && advanced.checked
                            DmeTextField { id: creatureName; Layout.fillWidth: true; placeholderText: "Creature name" }
                            DmeButton {
                                text: spawnGroup.currentValue === "master" ? "Replace boss master"
                                    : dialog.zoneGeometry.playerRelative ? "Add spawn with offset" : "Add spawn at hovered tile"
                                enabled: !dialog.hasDraft && !!spawnGroup.currentValue && creatureName.text.trim().length > 0
                                onClicked: {
                                    const offset = dialog.spawnOffset()
                                    if (!offset) {
                                        dialog.status = dialog.zoneGeometry.playerRelative
                                            ? "Enter an offset such as 2:0:0." : "Hover a tile at or after the zone origin."
                                        return
                                    }
                                    const entry = "{ name = " + JSON.stringify(creatureName.text.trim())
                                                + ", position = " + JSON.stringify(offset) + " }"
                                    const group = spawnGroup.currentValue
                                    const updated = dialog.reader.replaceBlackTekZoneField(
                                        source.text, dialog.selectedZone, group, entry, group !== "master")
                                    if (!updated) {
                                        dialog.status = "Could not add to that spawn group. Check the source TOML."
                                        return
                                    }
                                    if (dialog.commitSource(updated, group === "master" ? "Boss master set." : "Spawn added."))
                                        creatureName.text = ""
                                }
                            }
                        }
                        RowLayout {
                            Layout.fillWidth: true
                            visible: dialog.selectedSpawn !== null
                            ComboBox {
                                id: spawnSetting
                                model: spawnGroup.currentValue === "npcs" ? ["interval"]
                                    : spawnGroup.currentValue === "minions" ? ["interval", "chance", "delay"]
                                    : spawnGroup.currentValue === "monsters" && dialog.zoneGeometry.staged
                                        ? ["interval", "chance", "wave"] : ["interval", "chance"]
                            }
                            SpinBox {
                                id: spawnSettingValue
                                from: 0
                                to: spawnSetting.currentText === "chance" ? 100
                                    : spawnSetting.currentText === "wave" ? 255
                                    : spawnSetting.currentText === "delay" ? 2147483647 : 4294967
                                editable: true
                                value: dialog.selectedSpawn ? dialog.selectedSpawn[spawnSetting.currentText] || 0 : 0
                            }
                            Label {
                                text: spawnSetting.currentText === "chance" ? "%"
                                    : spawnSetting.currentText === "wave" ? ""
                                    : spawnSetting.currentText === "delay" ? "milliseconds" : "seconds"
                            }
                            DmeButton {
                                text: "Set spawn rule"
                                enabled: !!dialog.selectedSpawn && !dialog.hasDraft
                                onClicked: {
                                    const path = dialog.spawnFieldPath(dialog.selectedSpawn, spawnSetting.currentText)
                                    const updated = dialog.reader.replaceBlackTekZoneField(
                                        source.text, dialog.selectedZone, path, String(spawnSettingValue.value), false)
                                    if (!updated) { dialog.status = "Could not set that spawn rule."; return }
                                    dialog.commitSource(updated, "Spawn rule updated.")
                                }
                            }
                        }
                        DmeButton {
                            text: "Open zones.toml"
                            visible: advanced.checked
                            enabled: dialog.reader.blackTekZoneFolder.length > 0 && !dialog.hasDraft
                            onClicked: {
                                dialog.selectedZone = ""
                                dialog.openSource(dialog.reader.blackTekZoneFolder + "/zones.toml")
                            }
                        }
                        TextArea {
                            id: source
                            Layout.fillWidth: true
                            Layout.preferredHeight: 190
                            visible: advanced.checked && dialog.selectedFile.length > 0
                            wrapMode: TextEdit.WrapAnywhere
                            textFormat: TextEdit.PlainText
                        }
                        RowLayout {
                            visible: dialog.hasDraft
                            DmeButton { text: "Apply changes"; onClicked: dialog.commitSource(source.text, "Changes applied.") }
                            DmeButton {
                                text: "Discard draft"
                                onClicked: {
                                    dialog.openSource(dialog.selectedFile)
                                    dialog.status = "Draft discarded."
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
